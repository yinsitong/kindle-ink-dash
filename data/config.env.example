# 本机配置示例：复制为 data/config.env 后按需修改。
# data/ 已被 .gitignore 排除，填写内容不会进版本库。

# ── 飞书 CLI（可选）──────────────────────────────
# 日程 / 待办 / 妙记三页依赖 lark-cli。脚本会自动在 PATH 和常见位置找，
# 装在别处时显式指定：
# LARK_CLI=/opt/homebrew/bin/lark-cli

# ── Kindle 设备（自动定位 IP 时需要）─────────────────
# 设备的 WiFi MAC，在 Kindle 的 设置 → 设备信息 里能看到。
# 不填则只能手工维护 data/.kindle-ip。
KINDLE_MAC=

# ── 图床端口 ──────────────────────────────────
# Mac 端 serve.py 监听、Kindle 端 dash.sh 拉图，两边要一致。
DASH_PORT=8077

# ── 额度页（可选）────────────────────────────────
# 一个含 dot_quota_monitor.py 的目录，该模块需提供
# query_deepseek() / query_kimi() 两个函数。
# 不配置时额度页显示 N/A，其余三页正常。
QUOTA_MODULE_DIR=

# ── 飞书群推送（可选）─────────────────────────────
# weekly_report.py --push 的目标群 ID，`lark-cli im +chats-list` 可查。
LARK_CHAT_ID=
